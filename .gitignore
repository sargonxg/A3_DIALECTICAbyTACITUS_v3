*.swp
*.swo

# Environment and secrets
.env
.env.*
!.env.example
*.pem
*.key
*.p12
secrets/

# Rust
/target/
**/*.rs.bk
# Cargo.lock is committed because DIALECTICA is an application and service repo,
# not a reusable library-only crate.

# Node and tooling
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# Python
__pycache__/
*.py[cod]
.venv/
venv/

# Build artifacts
dist/
build/
coverage/
tmp/
temp/

# Local capsule artifacts
artifacts/
local-capsules/
*.capsule.zip
*.capsule.tar.gz

# Graphify keeps useful repo maps in graphify-out, but cache, HTML, and
# machine-local root/manifest files are regenerated locally.
graphify-out/cache/
graphify-out/.graphify_root
graphify-out/manifest.json
graphify-out/graph.html
