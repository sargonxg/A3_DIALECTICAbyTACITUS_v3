{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "ProposalSet",
  "type": "object",
  "required": [
    "extraction_run",
    "proposals"
  ],
  "properties": {
    "extraction_run": {
      "$ref": "#/definitions/ExtractionRun"
    },
    "proposals": {
      "type": "array",
      "items": {
        "$ref": "#/definitions/ExtractionProposal"
      }
    }
  },
  "definitions": {
    "BuildMode": {
      "type": "string",
      "enum": [
        "auto_draft",
        "assisted",
        "plus_promoted"
      ]
    },
    "CapsuleType": {
      "type": "string",
      "enum": [
        "user",
        "situation",
        "tool",
        "output"
      ]
    },
    "ExtractionProposal": {
      "type": "object",
      "required": [
        "capsule_type",
        "confidence",
        "kind",
        "object_id",
        "payload",
        "proposal_id",
        "run_id",
        "uncertainty"
      ],
      "properties": {
        "capsule_type": {
          "$ref": "#/definitions/CapsuleType"
        },
        "confidence": {
          "type": "number",
          "format": "double"
        },
        "kind": {
          "$ref": "#/definitions/ProposalKind"
        },
        "object_id": {
          "type": "string"
        },
        "payload": true,
        "proposal_id": {
          "type": "string"
        },
        "review_triggers": {
          "default": [],
          "type": "array",
          "items": {
            "$ref": "#/definitions/ReviewTrigger"
          }
        },
        "run_id": {
          "type": "string"
        },
        "source_span_ids": {
          "default": [],
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "uncertainty": {
          "type": "string"
        }
      }
    },
    "ExtractionRun": {
      "type": "object",
      "required": [
        "build_mode",
        "contract_version",
        "model_receipts",
        "run_id",
        "source_pack_id",
        "type_inference"
      ],
      "properties": {
        "build_mode": {
          "$ref": "#/definitions/BuildMode"
        },
        "contract_version": {
          "type": "string"
        },
        "model_receipts": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/ModelInvocationReceipt"
          }
        },
        "requested_type": {
          "default": null,
          "anyOf": [
            {
              "$ref": "#/definitions/CapsuleType"
            },
            {
              "type": "null"
            }
          ]
        },
        "run_id": {
          "type": "string"
        },
        "source_pack_id": {
          "type": "string"
        },
        "type_inference": {
          "$ref": "#/definitions/TypeInference"
        }
      }
    },
    "ModelInvocationReceipt": {
      "type": "object",
      "required": [
        "created_at",
        "fixture_mode",
        "input_digest",
        "model",
        "output_digest",
        "prompt_template_id",
        "provider",
        "receipt_id"
      ],
      "properties": {
        "created_at": {
          "type": "string"
        },
        "fixture_mode": {
          "type": "boolean"
        },
        "input_digest": {
          "type": "string"
        },
        "model": {
          "type": "string"
        },
        "output_digest": {
          "type": "string"
        },
        "prompt_template_id": {
          "type": "string"
        },
        "provider": {
          "type": "string"
        },
        "receipt_id": {
          "type": "string"
        }
      }
    },
    "ProposalKind": {
      "type": "string",
      "enum": [
        "claim",
        "episode",
        "graph_node",
        "graph_edge",
        "ontology_term",
        "reasoning_device",
        "language_rule",
        "caveat",
        "rights_rule",
        "output_rule"
      ]
    },
    "ReviewTrigger": {
      "type": "object",
      "required": [
        "blocking",
        "level",
        "reason",
        "reviewer_role",
        "trigger_id"
      ],
      "properties": {
        "blocking": {
          "type": "boolean"
        },
        "level": {
          "$ref": "#/definitions/ReviewTriggerLevel"
        },
        "reason": {
          "type": "string"
        },
        "reviewer_role": {
          "type": "string"
        },
        "trigger_id": {
          "type": "string"
        }
      }
    },
    "ReviewTriggerLevel": {
      "type": "string",
      "enum": [
        "info",
        "human_review",
        "required_gate",
        "promotion_blocker"
      ]
    },
    "TypeInference": {
      "type": "object",
      "required": [
        "confidence",
        "explanation",
        "selected_type",
        "source"
      ],
      "properties": {
        "confidence": {
          "type": "number",
          "format": "double"
        },
        "conflicting_signals": {
          "default": [],
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "explanation": {
          "type": "string"
        },
        "selected_type": {
          "$ref": "#/definitions/CapsuleType"
        },
        "source": {
          "$ref": "#/definitions/TypeInferenceSource"
        }
      }
    },
    "TypeInferenceSource": {
      "type": "string",
      "enum": [
        "user_selected",
        "ai_suggested",
        "mixed"
      ]
    }
  }
}
