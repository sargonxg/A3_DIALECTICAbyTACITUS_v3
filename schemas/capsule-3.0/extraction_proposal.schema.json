{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "ExtractionProposal",
  "type": "object",
  "required": [
    "capsule_type",
    "confidence",
    "kind",
    "object_id",
    "payload",
    "proposal_id",
    "run_id",
    "uncertainty"
  ],
  "properties": {
    "capsule_type": {
      "$ref": "#/definitions/CapsuleType"
    },
    "confidence": {
      "type": "number",
      "format": "double"
    },
    "kind": {
      "$ref": "#/definitions/ProposalKind"
    },
    "object_id": {
      "type": "string"
    },
    "payload": true,
    "proposal_id": {
      "type": "string"
    },
    "review_triggers": {
      "default": [],
      "type": "array",
      "items": {
        "$ref": "#/definitions/ReviewTrigger"
      }
    },
    "run_id": {
      "type": "string"
    },
    "source_span_ids": {
      "default": [],
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "uncertainty": {
      "type": "string"
    }
  },
  "definitions": {
    "CapsuleType": {
      "type": "string",
      "enum": [
        "user",
        "situation",
        "tool",
        "output"
      ]
    },
    "ProposalKind": {
      "type": "string",
      "enum": [
        "claim",
        "episode",
        "graph_node",
        "graph_edge",
        "ontology_term",
        "reasoning_device",
        "language_rule",
        "caveat",
        "rights_rule",
        "output_rule"
      ]
    },
    "ReviewTrigger": {
      "type": "object",
      "required": [
        "blocking",
        "level",
        "reason",
        "reviewer_role",
        "trigger_id"
      ],
      "properties": {
        "blocking": {
          "type": "boolean"
        },
        "level": {
          "$ref": "#/definitions/ReviewTriggerLevel"
        },
        "reason": {
          "type": "string"
        },
        "reviewer_role": {
          "type": "string"
        },
        "trigger_id": {
          "type": "string"
        }
      }
    },
    "ReviewTriggerLevel": {
      "type": "string",
      "enum": [
        "info",
        "human_review",
        "required_gate",
        "promotion_blocker"
      ]
    }
  }
}
