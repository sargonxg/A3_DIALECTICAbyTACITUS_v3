{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "ElicitationSession",
  "type": "object",
  "required": [
    "answers",
    "capsule_type",
    "current_stage_id",
    "protocol_id",
    "session_id"
  ],
  "properties": {
    "answers": {
      "type": "array",
      "items": {
        "$ref": "#/definitions/ElicitationAnswer"
      }
    },
    "capsule_type": {
      "$ref": "#/definitions/CapsuleType"
    },
    "current_stage_id": {
      "type": "string"
    },
    "protocol_id": {
      "type": "string"
    },
    "session_id": {
      "type": "string"
    }
  },
  "definitions": {
    "CapsuleType": {
      "type": "string",
      "enum": [
        "user",
        "situation",
        "tool",
        "output"
      ]
    },
    "ElicitationAnswer": {
      "type": "object",
      "required": [
        "answer_id",
        "source_span_id",
        "stage_id",
        "text"
      ],
      "properties": {
        "answer_id": {
          "type": "string"
        },
        "derived_record_counts": {
          "default": {},
          "type": "object",
          "additionalProperties": {
            "type": "integer",
            "format": "uint",
            "minimum": 0.0
          }
        },
        "source_span_id": {
          "type": "string"
        },
        "stage_id": {
          "type": "string"
        },
        "text": {
          "type": "string"
        }
      }
    }
  }
}
