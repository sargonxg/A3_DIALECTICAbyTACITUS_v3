{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "PraxisCapsuleManifest",
  "description": "Canonical v3 manifest for a portable `.capsule` package.",
  "type": "object",
  "required": [
    "capsule_id",
    "category",
    "cores",
    "created_at",
    "layers_present",
    "provenance_root_hash",
    "purpose_profile",
    "signature",
    "spec_version",
    "title",
    "type",
    "updated_at",
    "version"
  ],
  "properties": {
    "capsule_id": {
      "type": "string"
    },
    "category": {
      "type": "string"
    },
    "cores": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "created_at": {
      "type": "string"
    },
    "depends_on": {
      "default": [],
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "layers_present": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "owner_uid": {
      "default": null,
      "type": [
        "string",
        "null"
      ]
    },
    "provenance_root_hash": {
      "type": "string"
    },
    "purpose_profile": {
      "$ref": "#/definitions/PurposeProfile"
    },
    "signature": {
      "type": "string"
    },
    "situation_id": {
      "default": null,
      "type": [
        "string",
        "null"
      ]
    },
    "spec_version": {
      "type": "string"
    },
    "title": {
      "type": "string"
    },
    "type": {
      "type": "string",
      "pattern": "^(user|situation|tool|output)$"
    },
    "updated_at": {
      "type": "string"
    },
    "version": {
      "type": "integer",
      "format": "uint64",
      "minimum": 0.0
    }
  },
  "definitions": {
    "PurposeProfile": {
      "type": "object",
      "required": [
        "audience",
        "misuse_conditions",
        "red_lines",
        "scope_in",
        "scope_out",
        "serves_decision",
        "staleness_policy",
        "success_criteria",
        "time_horizon"
      ],
      "properties": {
        "audience": {
          "type": "string"
        },
        "misuse_conditions": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "red_lines": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "scope_in": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "scope_out": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "serves_decision": {
          "type": "string"
        },
        "staleness_policy": {
          "$ref": "#/definitions/PurposeStalenessPolicy"
        },
        "success_criteria": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "time_horizon": {
          "type": "string"
        }
      }
    },
    "PurposeStalenessPolicy": {
      "type": "object",
      "required": [
        "refuse_after_days",
        "warn_after_days"
      ],
      "properties": {
        "refuse_after_days": {
          "type": "integer",
          "format": "uint32",
          "minimum": 0.0
        },
        "warn_after_days": {
          "type": "integer",
          "format": "uint32",
          "minimum": 0.0
        }
      }
    }
  }
}
