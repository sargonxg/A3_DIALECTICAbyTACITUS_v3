{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "ReviewLedgerRecord",
  "type": "object",
  "required": [
    "caveats",
    "decision",
    "object_ids",
    "review_action_id",
    "reviewed_at",
    "reviewer_role"
  ],
  "properties": {
    "caveats": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "decision": {
      "$ref": "#/definitions/ReviewState"
    },
    "expires_at": {
      "type": [
        "string",
        "null"
      ]
    },
    "object_ids": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "review_action_id": {
      "type": "string"
    },
    "reviewed_at": {
      "type": "string"
    },
    "reviewer_role": {
      "type": "string"
    }
  },
  "definitions": {
    "ReviewState": {
      "description": "Human-review state for a capsule or one of its internal objects.",
      "oneOf": [
        {
          "description": "Author-created or machine-proposed, not yet inspected.",
          "type": "string",
          "enum": [
            "draft"
          ]
        },
        {
          "description": "A reviewer must inspect before promotion.",
          "type": "string",
          "enum": [
            "needs_review"
          ]
        },
        {
          "description": "Approved for the recorded scope.",
          "type": "string",
          "enum": [
            "approved"
          ]
        },
        {
          "description": "Approved, but caveats must travel with the capsule.",
          "type": "string",
          "enum": [
            "approved_with_caveats"
          ]
        },
        {
          "description": "Blocked by review.",
          "type": "string",
          "enum": [
            "rejected"
          ]
        },
        {
          "description": "Approved for PRAXIS use.",
          "type": "string",
          "enum": [
            "promoted"
          ]
        }
      ]
    }
  }
}
