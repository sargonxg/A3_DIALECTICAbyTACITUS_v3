        "applies": {
          "type": "boolean"
        },
        "authority_type": {
          "type": "string"
        },
        "citation_style": {
          "type": "string"
        },
        "jurisdiction": {
          "type": "string"
        }
      }
    },
    "MarketplaceListing": {
      "type": "object",
      "required": [
        "capsule_id",
        "caveats",
        "freshness",
        "listing_id",
        "review_level",
        "rights_summary",
        "visibility"
      ],
      "properties": {
        "capsule_id": {
          "type": "string"
        },
        "caveats": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "freshness": {
          "type": "string"
        },
        "listing_id": {
          "type": "string"
        },
        "review_level": {
          "type": "string"
        },
        "rights_summary": {
          "type": "string"
        },
        "visibility": {
          "type": "string"
        }
      }
    },
    "OntologyMapping": {
      "type": "object",
      "required": [
        "confidence",
        "source_label",
        "term_id"
      ],
      "properties": {
        "confidence": {
          "type": "number",
          "format": "double"
        },
        "source_label": {
          "type": "string"
        },
        "term_id": {
          "type": "string"
        }
      }
    },
    "OntologySlice": {
      "type": "object",
      "required": [
        "deprecations",
        "domains",
        "frame_memberships",
        "language",
        "mappings",
        "namespace",
        "ontology_id",
        "review_notes",
        "terms",
        "version"
      ],
      "properties": {
        "deprecations": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "domains": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "frame_memberships": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/FrameMembership"
          }
        },
        "language": {
          "type": "string"
        },
        "legal_document_profile": {
          "anyOf": [
            {
              "$ref": "#/definitions/LegalDocumentProfile"
            },
            {
              "type": "null"
            }
          ]
        },
        "mappings": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/OntologyMapping"
          }
        },
        "namespace": {
          "type": "string"
        },
        "ontology_id": {
          "type": "string"
        },
        "review_notes": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "terms": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/OntologyTerm"
          }
        },
        "version": {
          "type": "string"
        }
      }
    },
    "OntologyTerm": {
      "type": "object",
      "required": [
        "broader",
        "definition",
        "label",
        "review_state",
        "source_span_ids",
        "term_id"
      ],
      "properties": {
        "broader": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "definition": {
          "type": "string"
        },
        "label": {
          "type": "string"
        },
        "review_state": {
          "$ref": "#/definitions/ReviewState"
        },
        "source_span_ids": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "term_id": {
          "type": "string"
        }
      }
    },
    "OutputContract": {
      "type": "object",
      "required": [
        "forbidden_claims",
        "output_contract_id",
        "output_type",
        "required_sections",
        "review_state",
        "source_receipts_required"
      ],
      "properties": {
        "forbidden_claims": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "output_contract_id": {
          "type": "string"
        },
        "output_type": {
          "type": "string"
        },
        "required_sections": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "review_state": {
          "$ref": "#/definitions/ReviewState"
        },
        "source_receipts_required": {
          "type": "boolean"
        }
      }
    },
    "ReasoningDevice": {
      "type": "object",
      "required": [
        "device_id",
        "failure_modes",
        "purpose",
        "review_state",
        "source_requirements",
        "steps",
        "title"
      ],
      "properties": {
        "device_id": {
          "type": "string"
        },
        "failure_modes": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "purpose": {
          "type": "string"
        },
        "review_state": {
          "$ref": "#/definitions/ReviewState"
        },
        "source_requirements": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "steps": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "title": {
          "type": "string"
        }
      }
    },
    "ReviewLedgerRecord": {
      "type": "object",
      "required": [
        "caveats",
        "decision",
        "object_ids",
        "review_action_id",
        "reviewed_at",
        "reviewer_role"
      ],
      "properties": {
        "caveats": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "decision": {
          "$ref": "#/definitions/ReviewState"
        },
        "expires_at": {
          "type": [
            "string",
            "null"
          ]
        },
        "object_ids": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "review_action_id": {
          "type": "string"
        },
        "reviewed_at": {
          "type": "string"
        },
        "reviewer_role": {
          "type": "string"
        }
      }
    },
    "ReviewState": {
      "description": "Human-review state for a capsule or one of its internal objects.",
      "oneOf": [
        {
          "description": "Author-created or machine-proposed, not yet inspected.",
          "type": "string",
          "enum": [
            "draft"
          ]
        },
        {
          "description": "A reviewer must inspect before promotion.",
          "type": "string",
          "enum": [
            "needs_review"
          ]
        },
        {
          "description": "Approved for the recorded scope.",
          "type": "string",
          "enum": [
            "approved"
          ]
        },
        {
          "description": "Approved, but caveats must travel with the capsule.",
          "type": "string",
          "enum": [
            "approved_with_caveats"
          ]
        },
        {
          "description": "Blocked by review.",
          "type": "string",
          "enum": [
            "rejected"
          ]
        },
        {
          "description": "Approved for PRAXIS use.",
          "type": "string",
          "enum": [
            "promoted"
          ]
        }
      ]
    },
    "RightsProfile": {
