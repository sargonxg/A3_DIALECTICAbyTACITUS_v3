        "citation_language",
        "deprecated_terms",
        "framing_rules",
        "primary_language",
        "profile_id",
        "review_state",
        "secondary_languages",
        "translation_notes",
        "uncertainty_language"
      ],
      "properties": {
        "approved_terms": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/LanguageRule"
          }
        },
        "audience_register": {
          "type": "string"
        },
        "blocked_phrases": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/LanguageRule"
          }
        },
        "citation_language": {
          "type": "string"
        },
        "deprecated_terms": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/LanguageRule"
          }
        },
        "framing_rules": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/LanguageRule"
          }
        },
        "primary_language": {
          "type": "string"
        },
        "profile_id": {
          "type": "string"
        },
        "review_state": {
          "$ref": "#/definitions/ReviewState"
        },
        "secondary_languages": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "translation_notes": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "uncertainty_language": {
          "type": "string"
        }
      }
    },
    "LanguageRule": {
      "type": "object",
      "required": [
        "reason",
        "rule_id",
        "text"
      ],
      "properties": {
        "reason": {
          "type": "string"
        },
        "review_action_ids": {
          "default": [],
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "rule_id": {
          "type": "string"
        },
        "source_span_ids": {
          "default": [],
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "text": {
          "type": "string"
        }
      }
    },
    "LegalDocumentProfile": {
      "type": "object",
