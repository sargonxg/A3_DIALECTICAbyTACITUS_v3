{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "CapsuleBundle",
  "description": "Complete local capsule bundle assembled from the canonical directory shape.",
  "type": "object",
  "required": [
    "agent_guidance",
    "capsule",
    "capsule_health",
    "eval_report",
    "graph_constraints",
    "graph_semantics",
    "graph_slice",
    "language_profile",
    "manifest",
    "marketplace_listing",
    "ontology_slice",
    "output_contracts",
    "reasoning_playbook",
    "retrieval_pack",
    "review_ledger",
    "rights_profile",
    "source_ledger",
    "temporal_ledger"
  ],
  "properties": {
    "agent_guidance": {
      "$ref": "#/definitions/AgentGuidance"
    },
    "capsule": true,
    "capsule_health": {
      "$ref": "#/definitions/CapsuleHealthReport"
    },
    "eval_report": true,
    "graph_constraints": true,
    "graph_semantics": true,
    "graph_slice": {
      "$ref": "#/definitions/GraphSlice"
    },
    "language_profile": {
      "$ref": "#/definitions/LanguageProfile"
    },
    "manifest": {
      "$ref": "#/definitions/CapsuleManifest"
    },
    "marketplace_listing": {
      "$ref": "#/definitions/MarketplaceListing"
    },
    "ontology_slice": {
      "$ref": "#/definitions/OntologySlice"
    },
    "output_contracts": {
      "type": "array",
      "items": {
        "$ref": "#/definitions/OutputContract"
      }
    },
    "reasoning_playbook": {
      "type": "array",
      "items": {
        "$ref": "#/definitions/ReasoningDevice"
      }
    },
    "retrieval_pack": {
      "type": "array",
      "items": true
    },
    "review_ledger": {
      "type": "array",
      "items": {
        "$ref": "#/definitions/ReviewLedgerRecord"
      }
    },
    "rights_profile": {
      "$ref": "#/definitions/RightsProfile"
    },
    "source_ledger": {
      "type": "array",
      "items": {
        "$ref": "#/definitions/SourceLedgerRecord"
      }
    },
    "temporal_ledger": {
      "type": "array",
      "items": {
        "$ref": "#/definitions/TemporalLedgerRecord"
      }
    }
  },
  "definitions": {
    "AgentGuidance": {
      "type": "object",
      "required": [
        "allowed_workflows",
        "audit_receipts_required",
        "citation_policy",
        "context_budget_policy",
        "graph_use_policy",
        "handoff_policy",
        "language_profile_refs",
        "reasoning_sequence",
        "stop_conditions",
        "tool_policy"
      ],
      "properties": {
        "allowed_workflows": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "audit_receipts_required": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "citation_policy": {
          "$ref": "#/definitions/CitationPolicy"
        },
        "context_budget_policy": {
          "type": "string"
        },
        "graph_use_policy": {
          "$ref": "#/definitions/GraphUsePolicy"
        },
        "handoff_policy": {
          "type": "string"
        },
        "language_profile_refs": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "reasoning_sequence": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "stop_conditions": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "tool_policy": {
          "$ref": "#/definitions/ToolPolicy"
        }
      }
    },
    "CapsuleHealthReport": {
      "type": "object",
      "required": [
        "capsule_id",
        "review_status",
        "source_coverage",
        "status",
        "temporal_status",
        "warnings"
      ],
      "properties": {
        "capsule_id": {
          "type": "string"
        },
        "review_status": {
          "type": "string"
        },
        "source_coverage": {
          "type": "string"
        },
        "status": {
          "type": "string"
        },
        "temporal_status": {
          "type": "string"
        },
        "warnings": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    },
    "CapsuleManifest": {
      "description": "Manifest for a portable capsule bundle.",
      "type": "object",
      "required": [
        "agent_guidance_profile",
        "bundle_digest",
        "capsule_health",
        "capsule_id",
        "capsule_type",
        "compatibility_profile",
        "compiled_at",
        "compiler_version",
        "created_at",
        "freshness",
        "graph_profile",
        "language_profile",
        "project_id",
        "reasoning_profile",
        "review_state",
        "rights_profile",
        "schema_version",
        "source_count",
        "status",
        "summary",
        "tenant_id",
        "title"
      ],
      "properties": {
        "agent_guidance_profile": {
          "type": "string"
        },
        "bundle_digest": {
          "type": "string"
        },
        "capsule_health": {
          "type": "string"
        },
        "capsule_id": {
          "type": "string"
        },
        "capsule_type": {
          "type": "string",
          "pattern": "^(user_capsule|situation_capsule|tool_capsule|output_capsule)$"
        },
        "compatibility_profile": {
          "type": "string"
        },
        "compiled_at": {
          "type": "string"
        },
        "compiler_version": {
          "type": "string"
        },
        "created_at": {
          "type": "string"
        },
        "freshness": {
          "type": "string"
        },
        "graph_profile": {
          "type": "string"
        },
        "language_profile": {
          "type": "string"
        },
        "project_id": {
          "type": "string"
        },
        "reasoning_profile": {
          "type": "string"
        },
        "review_state": {
          "$ref": "#/definitions/ReviewState"
        },
        "rights_profile": {
          "type": "string"
        },
        "schema_version": {
          "type": "string"
        },
        "source_count": {
          "type": "integer",
          "format": "uint",
          "minimum": 0.0
        },
        "status": {
          "type": "string"
        },
        "summary": {
          "type": "string"
        },
        "tenant_id": {
          "type": "string"
        },
        "title": {
          "type": "string"
        }
      }
    },
    "CitationPolicy": {
      "type": "object",
      "required": [
        "default_style",
        "required_for"
      ],
      "properties": {
        "default_style": {
          "type": "string"
        },
        "required_for": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    },
    "FrameMembership": {
      "type": "object",
      "required": [
