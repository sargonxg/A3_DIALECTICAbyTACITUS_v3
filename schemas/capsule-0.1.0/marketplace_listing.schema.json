      "type": "string"
    },
    "caveats": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "freshness": {
      "type": "string"
    },
    "listing_id": {
      "type": "string"
    },
    "review_level": {
      "type": "string"
    },
    "rights_summary": {
      "type": "string"
    },
    "visibility": {
      "type": "string"
    }
  }
